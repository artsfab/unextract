<Project Sdk="Microsoft.NET.Sdk">

  <!-- GUI の UI E2E (FlaUI UIA3)。配布形態の unextract-gui.exe を別プロセスとして起動し、UI Automation で操作・観測する。
       製品プロジェクトは参照しない (FakeCli もビルド順だけ)。実行は scripts/run-gui-ui-tests.ps1 だけが行う:
       通常は IsTestProject=false なので solution の build には入るが、dotnet test unextract.sln では実行されない。
       明示実行は -p:UnextractUiTests=true を付ける。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject Condition="'$(UnextractUiTests)' != 'true'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="..\Unextract.Gui.FakeCli\Unextract.Gui.FakeCli.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
