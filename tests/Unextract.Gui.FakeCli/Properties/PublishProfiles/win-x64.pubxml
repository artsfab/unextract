<Project>

  <!-- 使い方: dotnet publish tests/Unextract.Gui.FakeCli -p:PublishProfile=win-x64 -p:AssemblyName=unextract -o <出力先>
       (本物の CLI と同じ win-x64 自己完結型の単一ファイル。scripts/run-gui-ui-tests.ps1 が呼ぶ) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
