<Project Sdk="Microsoft.NET.Sdk">

  <!-- Win32 呼び出し (kernel32 の LibraryImport、SafeFileHandle)。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- LibraryImport のソース生成結果を obj/ に書き出し、生成が動いていることを確認できるようにする。 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unextract.Core\Unextract.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unextract.Windows.Tests" />
  </ItemGroup>

</Project>
