<Window x:Class="Unextract.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Unextract.Gui.Views"
        Title="unextract GUI" Width="1280" Height="820" MinWidth="720" MinHeight="460"
        FontFamily="Yu Gothic UI" FontSize="14" WindowStartupLocation="CenterScreen"
        Background="White" Foreground="#1B1B1B" UseLayoutRounding="True"
        Loaded="WindowLoaded" Closing="WindowClosing">
    <!-- Layout (docs/RATIONALE.md#gui-layout): search -> mode -> work list | details -> progress -> next step and batch actions -> status.
         The details show one viewed item; viewing never changes the batch selection (the row check boxes). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:Theme />
            </ResourceDictionary.MergedDictionaries>

            <!-- Work list rows. The row is the keyboard stop: arrows browse, Space toggles the check box. -->
            <DataTemplate x:Key="ArchiveRow">
                <Border Background="{StaticResource PanelBrush}" Margin="0,4,0,0" Padding="2,4,4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox AutomationProperties.AutomationId="ArchiveCheckBox" AutomationProperties.Name="{Binding DisplayName}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsParentEnabled}" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="このArchiveのTargetをまとめて選択・解除" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" AutomationProperties.AutomationId="ArchiveTargetCountText" Text="{Binding TargetCountText}"
                               Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" AutomationProperties.AutomationId="ArchivePathText"
                               Text="{Binding DisplayPath}" Style="{StaticResource Subtle}" FontSize="12" />
                </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="TargetRow">
                <Grid Margin="24,2,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox AutomationProperties.AutomationId="TargetCheckBox" AutomationProperties.Name="{Binding DisplayPath}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSettingsEditable}" Focusable="False"
                              VerticalAlignment="Top" Margin="0,3,8,0" ToolTip="一括操作（解析・削除）の対象にする" />
                    <Border Grid.Column="1" Style="{StaticResource Badge}" Width="96" Margin="0,1,8,0">
                        <TextBlock AutomationProperties.AutomationId="TargetRowStateText" Text="{Binding StateLabel}" FontSize="12" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock AutomationProperties.AutomationId="TargetRowPathText" Text="{Binding DisplayPath}" TextWrapping="Wrap" />
                        <TextBlock AutomationProperties.AutomationId="TargetRowSummaryText" Text="{Binding RowSummaryText}" Style="{StaticResource Subtle}"
                                   FontSize="12" Visibility="{Binding RowSummaryText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <local:ByItemTypeSelector x:Key="RowSelector" Archive="{StaticResource ArchiveRow}" Target="{StaticResource TargetRow}" />

            <Style x:Key="WorkRow" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="AutomationProperties.Name" Value="{Binding ItemName}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,1,1,1" Padding="2,0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#F3F6FA" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,0" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="Row" Property="BorderThickness" Value="3,2,2,2" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Details of the viewed archive. -->
            <DataTemplate x:Key="ArchiveDetail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="14,10,14,10">
                        <TextBlock Text="Archive" Style="{StaticResource FieldLabel}" />
                        <TextBox AutomationProperties.AutomationId="ArchiveDetailNameText" Text="{Binding DisplayName, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyText}" FontSize="16" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="フルパス" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" AutomationProperties.AutomationId="ArchiveDetailPathText" Text="{Binding DisplayPath, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyText}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="サイズ" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="更新日時" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModifiedText}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="Target数" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetCount}" Margin="0,2" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button AutomationProperties.AutomationId="AddTargetButton" Content="このArchiveにTargetを追加..." Click="AddTargetClicked"
                                    IsEnabled="{Binding IsSettingsEditable}" Style="{StaticResource PrimaryButton}" />
                            <Button AutomationProperties.AutomationId="AnalyzeArchiveButton" Content="このArchiveの未解析Targetを解析" Click="AnalyzeArchiveClicked"
                                    IsEnabled="{Binding IsSettingsEditable}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="このArchiveのTargetは、一覧でこのArchiveのすぐ下に並びます。Targetを選ぶと、状態・解析結果・削除結果を確認できます。" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" Text="まだTargetがありません。上のボタンで追加してください。"
                                   Visibility="{Binding TargetCount, Converter={StaticResource CollapsedWhen}}" />
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <!-- Details of the viewed Target. Below a minimum height the pane scrolls as a whole, so the entry list always keeps a usable height. -->
            <DataTemplate x:Key="TargetDetail">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="14,10,14,10" MinHeight="400"
                          Height="{Binding ViewportHeight, ElementName=DetailScroll, Converter={x:Static local:MarginlessHeight.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Target" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" ToolTip="削除するファイルを探すディレクトリ" />
                            <TextBox Grid.Column="1" AutomationProperties.AutomationId="TargetPathText" Text="{Binding DisplayPath, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="1" Text="Archive" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="TargetArchiveText" Text="{Binding Archive.DisplayPath, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyText}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="テンプレート" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="TargetTemplateText" Text="{Binding DisplayTemplate, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyText}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="存在確認" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="TargetPresenceText" Text="{Binding PresenceText}"
                                       TextWrapping="Wrap" Margin="0,2" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" Width="104" Margin="0,1,8,0">
                                <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" AutomationProperties.AutomationId="TargetStateText" Text="{Binding StateText}" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,6,0,0">
                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="AnalyzeTargetButton" Content="{Binding AnalyzeButtonText}" Click="AnalyzeTargetClicked"
                                        IsEnabled="{Binding CanAnalyze}" Style="{StaticResource PrimaryButton}" />
                                <Button AutomationProperties.AutomationId="EditTargetButton" Content="設定を編集..." Click="EditTargetClicked" IsEnabled="{Binding CanEdit}" />
                                <Button AutomationProperties.AutomationId="RefreshTargetButton" Content="存在を再確認" Click="RefreshTargetClicked" IsEnabled="{Binding CanRefresh}" />
                                <Button AutomationProperties.AutomationId="RemoveTargetButton" Content="一覧から除去" Click="RemoveTargetClicked" IsEnabled="{Binding CanRemove}"
                                        ToolTip="GUIのTarget設定を消します。ファイルは削除しません。" />
                            </WrapPanel>
                            <TextBlock AutomationProperties.AutomationId="TargetActionHintText" Text="{Binding ActionHint}" Style="{StaticResource Subtle}"
                                       Visibility="{Binding ActionHint, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,8,0,0" Visibility="{Binding AnalysisDetailText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="解析・削除の詳細" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.AutomationId="TargetAnalysisDetailText" Text="{Binding AnalysisDetailText, Mode=OneWay}"
                                     Style="{StaticResource DetailText}" MaxHeight="190" />

                        </StackPanel>
                        <Grid Grid.Row="5" Margin="0,10,0,0" Visibility="{Binding HasSuccessfulAnalysis, Converter={StaticResource VisibleWhen}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="110" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="解析結果のエントリ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" AutomationProperties.AutomationId="ResultCategoryCombo" AutomationProperties.Name="分類で絞り込み"
                                          ItemsSource="{Binding ResultCategories}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding ResultCategory, Mode=TwoWay}" MinWidth="170" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="パス:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Column="3" AutomationProperties.AutomationId="ResultPathFilterBox" AutomationProperties.Name="エントリのパスで絞り込む"
                                         Text="{Binding ResultPathFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="エントリのパスで絞り込む" />
                                <TextBlock Grid.Column="4" AutomationProperties.AutomationId="ResultCountText" Text="{Binding ResultCountText}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Subtle}" />
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0"
                                    Padding="6,3" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分類" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="サイズ (bytes)" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="ZIP内のパス" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="2" AutomationProperties.AutomationId="ResultList" AutomationProperties.Name="解析結果のエントリ"
                                     ItemsSource="{Binding VisibleResults}" BorderBrush="{StaticResource BorderBrush}"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Status}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LengthText}" TextAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" TextWrapping="Wrap">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <TextBlock Grid.Row="5" Margin="0,12,0,0" Style="{StaticResource Subtle}"
                                   Text="解析が正常に完了すると、ここにZIPの全エントリと分類が表示されます。"
                                   Visibility="{Binding HasSuccessfulAnalysis, Converter={StaticResource CollapsedWhen}}" />
                    </Grid>
                </ScrollViewer>
            </DataTemplate>
            <local:ByItemTypeSelector x:Key="DetailSelector" Archive="{StaticResource ArchiveDetail}" Target="{StaticResource TargetDetail}" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Below a minimum height of the work area the whole window scrolls (code-behind keeps Root.MinHeight), so the lists
         always keep a finite, usable height and no control is cut off. -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid x:Name="Root" Height="{Binding ViewportHeight, ElementName=RootScroll}" LayoutUpdated="RootLayoutUpdated">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Search. Declared in tab order (input, search, choose folder, recursive), which is also the visual order. -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid IsEnabled="{Binding IsSettingsEditable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ZIPを探すディレクトリ" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                <TextBox x:Name="SearchDirectoryBox" Grid.Column="1" Text="{Binding SearchDirectory, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="ZIPを探すディレクトリ" Margin="0,0,8,0" KeyDown="SearchBoxKeyDown" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="検索" Click="SearchClicked" Style="{StaticResource PrimaryButton}" MinWidth="64" />
                <Button x:Name="ChooseFolderButton" Grid.Column="3" Content="フォルダーを選択..." Click="ChooseFolderClicked" />
                <CheckBox x:Name="RecursiveCheckBox" Grid.Column="4" Content="サブディレクトリも検索" IsChecked="{Binding Recursive}" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- 2. Verification mode for the whole session. One tab stop; arrows or Space change it (with the same confirmation as a click). -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,5">
            <DockPanel>
                <TextBlock x:Name="CliStatusText" DockPanel.Dock="Right" Text="{Binding CliMessage}" Style="{StaticResource Subtle}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="12,0,0,0"
                           ToolTip="{Binding CliPath}" />
                <TextBlock Text="検証モード" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel x:Name="ModeGroup" Orientation="Horizontal" IsEnabled="{Binding IsSettingsEditable}" VerticalAlignment="Center"
                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                            PreviewKeyDown="ModeGroupKeyDown" GotKeyboardFocus="ModeGroupGotFocus">
                    <RadioButton x:Name="StrictRadio" Content="Strict（全バイト比較）" Tag="Strict" GroupName="Mode" IsChecked="{Binding IsStrict, Mode=OneWay}"
                                 Click="ModeClicked" Margin="0,0,16,0" />
                    <RadioButton x:Name="FastRadio" Content="Fast（パスとサイズのみ）" Tag="Fast" GroupName="Mode" IsChecked="{Binding IsFast, Mode=OneWay}"
                                 Click="ModeClicked" />
                </StackPanel>
                <TextBlock x:Name="ModeDescriptionText" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Text="ZIPの内容と全バイト一致したファイルだけを削除候補にします。"
                           Visibility="{Binding IsStrict, Converter={StaticResource VisibleWhen}}" />
            </DockPanel>
        </Border>
        <Border x:Name="FastWarning" Grid.Row="2" Style="{StaticResource WarningPanel}" Margin="14,6,14,0"
                Visibility="{Binding IsFast, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
                <TextBlock Text="Fastモード" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                <TextBlock x:Name="FastWarningText" Text="{Binding ModeWarning}" TextWrapping="Wrap" Foreground="#7D1A13" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <Border x:Name="CliMissingBanner" Grid.Row="3" Style="{StaticResource WarningPanel}" Margin="14,6,14,0"
                Visibility="{Binding IsCliAvailable, Converter={StaticResource CollapsedWhen}}">
            <TextBlock Text="{Binding CliMessage}" TextWrapping="Wrap" Foreground="#7D1A13" FontWeight="SemiBold" />
        </Border>

        <!-- 3. Work list (left) and the viewed item (right). -->
        <Grid Grid.Row="4" Margin="14,8,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="ArchiveCountText" DockPanel.Dock="Right" Text="{Binding ArchiveCountText}" Style="{StaticResource Subtle}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap" />
                    <TextBlock Text="Archiveを絞り込み" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="ArchiveFilterBox" Text="{Binding ArchiveFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Archiveのファイル名またはパスで絞り込む" ToolTip="Archiveのファイル名またはパスで表示を絞り込みます（選択は変わりません）" />
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,4,0,2" IsEnabled="{Binding IsSettingsEditable}">
                    <Button x:Name="BulkAddButton" Content="全Archiveに一括追加..." Click="BulkAddClicked" ToolTip="検索した全ArchiveにTargetを同じルールで追加します" />
                    <Button x:Name="SelectionMenuButton" Content="選択をまとめて変更 ▾" Click="SelectionMenuClicked"
                            ToolTip="一括操作（解析・削除）の対象にするTargetのチェックを、まとめて付けたり外したりします">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SelectionMenu">
                                <MenuItem x:Name="SelectAllButton" Header="すべて選択" Click="SelectAllClicked" />
                                <MenuItem x:Name="ClearAllButton" Header="すべて解除" Click="ClearAllClicked" />
                                <Separator />
                                <MenuItem x:Name="SelectVisibleButton" Header="絞り込みで表示中のTargetをすべて選択" Click="SelectVisibleClicked" />
                                <MenuItem x:Name="ClearVisibleButton" Header="絞り込みで表示中のTargetをすべて解除" Click="ClearVisibleClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
                <ListBox x:Name="ArchiveList" Grid.Row="2" ItemsSource="{Binding WorkItems}" SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                         ItemTemplateSelector="{StaticResource RowSelector}" ItemContainerStyle="{StaticResource WorkRow}"
                         AutomationProperties.Name="ArchiveとTargetの一覧" BorderBrush="{StaticResource BorderBrush}"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                         PreviewKeyDown="WorkListKeyDown" SelectionChanged="WorkListSelectionChanged" />
                <TextBlock Grid.Row="2" Margin="14" Style="{StaticResource Subtle}" IsHitTestVisible="False"
                           Text="検索すると、見つかったZIP（Archive）と、それぞれに追加したTargetがここに並びます。"
                           Visibility="{Binding HasSession, Converter={StaticResource CollapsedWhen}}" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" ShowsPreview="False" />
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource WarningSoftBrush}" Padding="10,4" Visibility="{Binding ViewedHiddenText, Converter={StaticResource VisibleWhen}}">
                        <TextBlock x:Name="ViewedHiddenText" Text="{Binding ViewedHiddenText}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <ContentControl x:Name="DetailPanel" Grid.Row="1" Content="{Binding Viewed}" ContentTemplateSelector="{StaticResource DetailSelector}"
                                    Focusable="False" IsTabStop="False" />
                    <TextBlock Grid.Row="1" Margin="16" Style="{StaticResource Subtle}"
                               Text="一覧でArchiveまたはTargetを選ぶと、ここに詳細が表示されます。Targetでは状態・解析結果の全エントリ・削除結果を確認できます。"
                               Visibility="{Binding Viewed, Converter={StaticResource CollapsedWhen}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Progress of the running analysis or delete. -->
        <Border x:Name="ProgressPanel" Grid.Row="5" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,1,0,0" Padding="14,5" Visibility="{Binding IsJobRunning, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
                <Button x:Name="CancelAnalysisButton" DockPanel.Dock="Right" Content="解析をキャンセル" Click="CancelAnalysisClicked" VerticalAlignment="Center"
                        Margin="8,0,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource VisibleWhen}}" />
                <StackPanel>
                    <WrapPanel>
                        <TextBlock x:Name="OverallProgressText" Text="{Binding OverallProgressText}" FontWeight="SemiBold" Margin="0,0,14,0" />
                        <TextBlock x:Name="EntryProgressText" Text="{Binding EntryProgressText}" FontWeight="SemiBold" Margin="0,0,14,0" />
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"
                                   Text="（件数はCLIの出力から数えます。Strictで大きなファイルを比較している間は進みません）" />
                    </WrapPanel>
                    <TextBlock x:Name="CurrentArchiveText" Text="{Binding CurrentArchiveText}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="CurrentTargetText" Text="{Binding CurrentTargetText}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Next step, what the batch actions would act on, and the batch actions. Delete is set apart and never the default. -->
        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="NextStepText" Grid.ColumnSpan="2" Text="{Binding NextStepText}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="SelectionSummaryText" Grid.Row="1" Text="{Binding SelectionSummaryText}" TextWrapping="Wrap" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.ToolTip>
                        <StackPanel MaxWidth="520">
                            <TextBlock x:Name="AnalysisSummaryText" Text="{Binding AnalysisSummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AnalysisSummaryNote}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </TextBlock.ToolTip>
                </TextBlock>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsSettingsEditable}">
                    <Button x:Name="AnalyzeSelectedButton" Content="選択中の未解析Targetを解析" Click="AnalyzeSelectedClicked" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="DeleteSelectedButton" Content="選択中のTargetを削除..." Click="DeleteSelectedClicked" Style="{StaticResource DangerButton}"
                            Margin="16,3,0,3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status, notifications and the log folder. -->
        <!-- Columns in visual (and tab) order. -->
        <Grid Grid.Row="7" Margin="14,3,14,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ToggleButton x:Name="DiagnosticsToggle" Grid.Column="1" Content="{Binding DiagnosticCountText}" Padding="8,2" MinHeight="26" Margin="8,0,0,0"
                          VerticalAlignment="Center" ToolTip="検索・Target登録・設定保存・一時ファイルの通知を表示します" />
            <Button x:Name="OpenLogFolderButton" Grid.Column="2" Content="実行ログの保存フォルダーを開く" Click="OpenLogFolderClicked" Padding="8,2"
                    MinHeight="26" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ListBox x:Name="DiagnosticsList" Grid.Row="8" ItemsSource="{Binding Diagnostics}" MaxHeight="130" Margin="14,0,14,6"
                 AutomationProperties.Name="通知" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderBrush="{StaticResource BorderBrush}"
                 Visibility="{Binding IsChecked, ElementName=DiagnosticsToggle, Converter={StaticResource VisibleWhen}}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="8" Margin="22,4,14,8" Style="{StaticResource Subtle}" IsHitTestVisible="False" Text="通知はありません。">
            <TextBlock.Visibility>
                <MultiBinding Converter="{x:Static local:EmptyListNote.Instance}">
                    <Binding Path="IsChecked" ElementName="DiagnosticsToggle" />
                    <Binding Path="Diagnostics.Count" />
                </MultiBinding>
            </TextBlock.Visibility>
        </TextBlock>
    </Grid>
    </ScrollViewer>
</Window>
