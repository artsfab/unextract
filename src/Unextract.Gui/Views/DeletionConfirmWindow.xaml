<Window x:Class="Unextract.Gui.Views.DeletionConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Unextract.Gui.Views"
        Title="削除の確認" Width="780" Height="660" MinWidth="520" MinHeight="380"
        FontFamily="Yu Gothic UI" FontSize="14" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" UseLayoutRounding="True" AutomationProperties.AutomationId="DeletionConfirmWindow">
    <!-- The single confirmation of a delete batch. Warnings first, then the numbers, then every Target and exclusion.
         Cancel is the default and the Escape action; the delete button is set apart and must be chosen explicitly. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:Theme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The buttons stay visible; when the dialog is short, the part above them scrolls as a whole (the list keeps a usable height). -->
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="18,14,18,0" MinHeight="380"
          Height="{Binding ViewportHeight, ElementName=ContentScroll, Converter={x:Static local:MarginlessHeight.Top}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
        </Grid.RowDefinitions>
        <Border x:Name="IrreversiblePanel" Style="{StaticResource WarningPanel}">
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="DeletionConfirmHeading" />
                <TextBlock x:Name="IrreversibleText" TextWrapping="Wrap" Foreground="#7D1A13" Margin="0,4,0,0" AutomationProperties.AutomationId="DeletionConfirmIrreversible"
                           Text="ごみ箱は使わず、完全に削除します。途中で停止した場合も、それまでに削除したファイルは元に戻りません。" />
            </StackPanel>
        </Border>
        <Border x:Name="FastPanel" Grid.Row="1" Style="{StaticResource WarningPanel}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="Fastモード" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="FastText" TextWrapping="Wrap" Foreground="#7D1A13" FontWeight="SemiBold" AutomationProperties.AutomationId="DeletionConfirmFastWarning" />
            </DockPanel>
        </Border>
        <Grid x:Name="SummaryGrid" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="モード" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="ModeText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" AutomationProperties.AutomationId="DeletionConfirmMode" />
            <TextBlock Grid.Row="1" Text="削除するTarget" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="TargetCountText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" AutomationProperties.AutomationId="DeletionConfirmTargetCount" />
            <TextBlock Grid.Row="2" Text="削除候補ファイル数" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="FileCountText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" AutomationProperties.AutomationId="DeletionConfirmFileCount" />
            <TextBlock Grid.Row="3" Text="削除候補サイズ" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" AutomationProperties.AutomationId="DeletionConfirmSize" />
            <TextBlock Grid.Row="4" Text="除外するTarget" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="ExcludedCountText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" AutomationProperties.AutomationId="DeletionConfirmExcludedCount" />
        </Grid>
        <Border x:Name="HiddenPanel" Grid.Row="3" Background="{StaticResource WarningSoftBrush}" BorderBrush="#B07300" BorderThickness="2,1,1,1"
                Padding="10,5" Margin="0,8,0,0" CornerRadius="3">
            <TextBlock x:Name="HiddenText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="DeletionConfirmHidden" />
        </Border>
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="削除対象と除外の一覧（全件。Tabで移動して矢印キーでも読めます）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="Body" Style="{StaticResource DetailText}" AutomationProperties.AutomationId="DeletionConfirmBody"
                     AutomationProperties.Name="削除対象と除外の一覧" />
        </DockPanel>
    </Grid>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="18,10,18,12" LastChildFill="False">
            <!-- Declared in visual order (delete on the left, cancel on the right), which is also the tab order. -->
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Click="DeleteClicked" MinWidth="150"
                    AutomationProperties.AutomationId="DeletionConfirmDeleteButton" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" IsDefault="True" IsCancel="True" MinWidth="96" Margin="0,3,0,3"
                    AutomationProperties.AutomationId="DeletionConfirmCancelButton" />

        </DockPanel>
    </Grid>
</Window>
